{
  "name": "devin-my-blog",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "content:build": "node --env-file-if-exists=.env.local --experimental-strip-types build/content-cli.ts",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings src build vite.config.ts",
    "lint:fix": "oxlint --fix --deny-warnings src build vite.config.ts",
    "check": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "beautiful-mermaid": "1.1.3",
    "highlight.js": "11.12.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "framer-motion": "12.36.0",
    "markdown-to-jsx": "9.10.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
